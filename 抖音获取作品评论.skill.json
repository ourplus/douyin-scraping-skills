    "rules": {
      "platform": "douyin",
      "version": "1.0.0",
      "meta": {
        "name": "抖音",
        "baseUrl": "https://www.douyin.com",
        "capabilities": [
          "view_list_item",
          "view_detail",
          "scroll",
          "comment"
        ],
        "titlePattern": "抖音"
      },
      "routes": {
        "home": {
          "url": "https://www.douyin.com",
          "check": {
            "url": "https://www.douyin.com/jingxuan"
          }
        },
        "recommend": {
          "locator": "div[data-e2e=\"douyin-navigation\"] >> text=推荐",
          "check": {
            "url": "https://www.douyin.com/?recommend=1"
          }
        },
        "jingxuan": {
          "locator": "div[data-e2e=\"douyin-navigation\"] >> text=精选",
          "url": "https://www.douyin.com/jingxuan"
        }
      },
      "extractors": {
        "post_list": {
          "itemSelector": "ul[data-e2e=\"scroll-list\"] li",
          "idField": "id",
          "fields": [
            {
              "name": "id",
              "selector": "a[href^=\"/video/\"]",
              "source": "href",
              "match": "/video/(\\d+)",
              "fallback": ""
            },
            {
              "name": "url",
              "selector": "a[href^=\"/video/\"]",
              "source": "href",
              "match": "(/video/\\d+)",
              "prefix": "https://www.abc.com",
              "fallback": ""
            },
            {
              "name": "image",
              "selector": "a[href^=\"/video/\"] img",
              "source": "src",
              "fallback": ""
            },
            {
              "name": "status",
              "selector": "[aria-label^=\"Tag:\"]",
              "source": {
                "attr": "aria-label"
              },
              "match": "Tag:\\s*(.+)",
              "fallback": ""
            },
            {
              "name": "comments",
              "selector": ".author-card-user-video-like span:last-child",
              "source": "text",
              "fallback": "0"
            },
            {
              "name": "intro",
              "selector": "a[href^=\"/video/\"] img",
              "source": {
                "attr": "alt"
              },
              "fallback": ""
            }
          ]
        },
        "content_comment_list": {
          "itemSelector": "div[data-e2e=\"comment-item\"]",
          "idField": "userUuid",
          "readiness": ".comment-item-avatar a",
          "fields": [
            {
              "name": "userUuid",
              "selector": ".comment-item-avatar a[href*=\"/user/\"]",
              "source": {
                "attr": "href"
              },
              "match": "/user/([\\w-]+)"
            },
            {
              "name": "userAvatar",
              "selector": ".comment-item-avatar a[href*=\"/user/\"] img",
              "source": "src"
            },
            {
              "name": "userNickname",
              "selector": ".comment-item-avatar a[href*=\"/user/\"] img",
              "source": {
                "attr": "alt"
              },
              "match": "^(.+?)头像"
            },
            {
              "name": "comment",
              "selector": ".comment-item-info-wrap + div span",
              "source": "text"
            },
            {
              "name": "time",
              "selector": ".comment-item-info-wrap + div + div span",
              "source": "text",
              "match": "^([^·]+)"
            },
            {
              "name": "location",
              "selector": ".comment-item-info-wrap + div + div span",
              "source": "text",
              "match": "·(.+)$"
            },
            {
              "name": "replyCount",
              "selector": ".replyContainer button",
              "source": "text",
              "match": "(\\d+)",
              "fallback": "0"
            }
          ]
        },
        "content_info": {
          "itemSelector": "div.parent-route-container.route-scroll-container",
          "idField": "vid",
          "fields": [
            {
              "name": "author",
              "selector": "span.account-name-text",
              "source": "text"
            },
            {
              "name": "time",
              "selector": "div.video-create-time",
              "source": "text"
            },
            {
              "name": "intro",
              "selector": "div[data-e2e=\"video-desc\"]",
              "source": "text"
            },
            {
              "name": "like",
              "selector": "div[data-e2e=\"video-player-digg\"]",
              "source": "text"
            },
            {
              "name": "comment",
              "selector": "div[data-e2e=\"feed-comment-icon\"]",
              "source": "text"
            },
            {
              "name": "collect",
              "selector": "div[data-e2e=\"video-player-collect\"]",
              "source": "text"
            },
            {
              "name": "share",
              "selector": "div[data-e2e=\"video-player-share\"]",
              "source": "text"
            },
            {
              "name": "vid",
              "selector": "div[data-e2e-vid]",
              "source": {
                "attr": "data-e2e-vid"
              }
            },
            {
              "name": "uid",
              "selector": "a[data-e2e=\"video-avatar\"]",
              "source": {
                "attr": "href"
              },
              "match": "/user/([\\w-]+)"
            }
          ]
        },
        "search_videos": {
          "itemSelector": "div#waterFallScrollContainer > div",
          "idField": "vid",
          "fields": [
            {
              "name": "vid",
              "source": {
                "attr": "id"
              },
              "match": "waterfall_item_(\\d+)"
            },
            {
              "name": "thumb",
              "selector": "div.search-result-card div.videoImage img",
              "source": "src"
            },
            {
              "name": "duration",
              "selector": "div.search-result-card div.videoImage div",
              "source": "text",
              "match": "\\d{1,2}:\\d{2}"
            },
            {
              "name": "like",
              "selector": "div.search-result-card div.videoImage svg + span",
              "source": "text"
            },
            {
              "name": "intro",
              "selector": "div.search-result-card div.videoImage + div > div > div:not(:has(> span))",
              "source": "text"
            },
            {
              "name": "author",
              "selector": "div.search-result-card div.videoImage + div span:text-is(\"@\") + span",
              "source": "text"
            },
            {
              "name": "time",
              "selector": "div.search-result-card div.videoImage + div span:has-text(\" · \")",
              "source": "text"
            }
          ]
        }
      },
      "actions": {
        "dismissPopups": {
          "steps": [
            {
              "atom": "dismiss",
              "options": {
                "selector": "div:text('登录后免费畅享高清视频') + div"
              }
            },
            {
              "atom": "dismiss",
              "options": {
                "selector": "#douyin-web-recommend-guide-mask"
              }
            }
          ]
        }
      },
      "selectors": {},
      "anomalyChecks": [],
      "locationPatterns": []
    }
  }
