    "skill_code": "const vid = String(tobub.params.vid);\nconst maxScrollTimes = Number(tobub.params.maxScrollTimes);\nconst records = [];\nconst videoContent = await tobub.db.saveContent({\n  platform: \"douyin\",\n  contentType: \"video\",\n  externalId: vid,\n  title: \"抖音视频 \" + vid,\n  url: \"https://www.douyin.com/video/\" + vid,\n  rawData: { videoId: vid }\n});\nawait tobub.adapter.navigate({ url: \"https://www.douyin.com/video/\" + vid, waitUntil: \"domcontentloaded\" });\nawait tobub.atoms.waitFor({ selector: 'div[data-scroll=\"comment\"]', selectorState: \"attached\", timeout: 15000 });\nawait tobub.adapter.dismissPopups();\nawait tobub.atoms.waitFor({ delay: tobub.utils.randInt(3000, 6000) });\nfor (let i = 0; i < maxScrollTimes; i++) {\n  if (tobub.utils.chance(0.5)) {\n    await tobub.atoms.scroll({ mode: \"viewport\", distance: tobub.utils.randInt(390, 1200), steps: tobub.utils.randInt(3, 15), stepPauseRange: [10, 25] });\n  } else {\n    await tobub.atoms.scroll({ mode: \"viewport\", distance: 500, steps: 1, stepPauseRange: [10, 25] });\n  }\n  await tobub.atoms.waitFor({ delay: tobub.utils.randInt(1500, 3200) });\n  const postList = await tobub.adapter.extract(\"content_comment_list\", { scan: { mode: \"append\" } });\n  for (const record of postList.records) {\n    records.push(record);\n    const fields = record.fields ?? {};\n    const commenterId = String(record.id || fields.userUuid || \"\");\n    const externalId = commenterId ? vid + \":\" + commenterId : \"\";\n    if (!externalId) continue;\n    await tobub.db.saveContent({\n      platform: \"douyin\",\n      contentType: \"comment\",\n      externalId,\n      parentId: videoContent.contentItemId,\n      title: fields.comment ?? \"抖音评论\",\n      summary: fields.userNickname ?? \"\",\n      url: \"https://www.douyin.com/video/\" + vid,\n      metadata: {\n        videoId: vid,\n        userUuid: fields.userUuid ?? commenterId,\n        userAvatar: fields.userAvatar ?? \"\",\n        time: fields.time ?? \"\",\n        location: fields.location ?? \"\",\n        replyCount: fields.replyCount ?? \"0\"\n      },\n      rawData: fields\n    });\n  }\n  if (postList.scannedCount === 0) {\n    const endState = await tobub.atoms.condition({ type: \"text\", selector: \"body\", text: \"暂时没有更多评论\", timeout: 250, throwOnTimeout: false });\n    if (endState.satisfied) break;\n  }\n}\nreturn { videoId: vid, records };",
