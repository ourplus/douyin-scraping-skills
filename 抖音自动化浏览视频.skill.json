    "release_id": "local-tests-20260906",
    "name": "抖音自动化浏览视频",
    "source_type": "local",
    "skill_code": "const maxScrollTimes = Number(tobub.params.maxScrollTimes);\nconst records = [];\nawait tobub.adapter.bootstrap();\nawait tobub.atoms.waitFor({ text: \"登录后免费畅享高清视频\", timeout: 30000 });\nawait tobub.adapter.dismissPopups();\nawait tobub.adapter.navigate({ name: \"recommend\" });\nfor (let i = 0; i < maxScrollTimes; i++) {\n  const reloadFlag = tobub.utils.chance(1 / 20);\n  if (reloadFlag) await tobub.atoms.refresh({ waitUntil: \"domcontentloaded\" });\n  await tobub.adapter.dismissPopups();\n  if (reloadFlag) await tobub.adapter.navigate({ name: \"recommend\" });\n  const sleepTime = tobub.utils.randInt(30000, 90000);\n  if (tobub.utils.chance(1 / 15)) await tobub.atoms.waitFor({ delay: sleepTime });\n  await tobub.atoms.swipeVideo({ mode: \"wheel\", target: { selector: \".parent-route-container.route-scroll-container\" } });\n  const dataList = await tobub.adapter.extract(\"content_info\");\n  if (dataList.newCount > 0 && dataList.records[0]) {\n    const record = dataList.records[0];\n    records.push(record);\n    const fields = record.fields ?? {};\n    const externalId = String(record.id || fields.vid || \"\");\n    if (externalId) {\n      await tobub.db.saveContent({\n        platform: \"douyin\",\n        contentType: \"video\",\n        externalId,\n        title: fields.intro ?? \"抖音视频 \" + externalId,\n        summary: fields.author ?? \"\",\n        url: \"https://www.douyin.com/video/\" + externalId,\n        metadata: {\n          author: fields.author ?? \"\",\n          time: fields.time ?? \"\",\n          like: fields.like ?? \"\",\n          comment: fields.comment ?? \"\",\n          collect: fields.collect ?? \"\",\n          share: fields.share ?? \"\",\n          uid: fields.uid ?? \"\"\n        },\n        rawData: fields\n      });\n    }\n  }\n  await tobub.atoms.waitFor({ delay: tobub.utils.randInt(5000, 10000) });\n  const sleepRandomTime = tobub.utils.randInt(5000, 10000);\n  if (tobub.utils.chance(1 / 5)) await tobub.atoms.waitFor({ delay: sleepRandomTime });\n}\nreturn { records };",
    "platform": "douyin",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxScrollTimes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "default": 500
        }
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records"
      ],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "ui_schema": {
      "version": 1,
      "fields": [
        {
          "key": "maxScrollTimes",
          "label": "最大浏览次数",
          "type": "number",
          "target": "params.maxScrollTimes",
          "required": true,
          "default": 500
        }
      ]
    },
    "requirements": {
      "account": "optional",
      "profile": "optional",
      "domain_rule": "required"
    },
    "defaults": {
      "params": {
        "maxScrollTimes": 500
      },
      "browser": {
        "run_mode": "transient",
        "headless": false
      }
    },
