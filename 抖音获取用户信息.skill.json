  "skill": {
    "market_skill_id": "douyin-get-user-info",
    "release_id": "local-tests-20260906",
    "name": "抖音获取用户信息",
    "source_type": "local",
    "skill_code": "const uid = String(tobub.params.uid);\nawait tobub.adapter.navigate({ url: \"https://www.douyin.com/user/\" + uid, waitUntil: \"domcontentloaded\" });\nawait tobub.atoms.waitFor({ title: \"的抖音\", titleMatch: \"contains\", timeout: 15000 });\nawait tobub.atoms.waitFor({ text: \"登录后免费畅享高清视频\", timeout: 30000 });\nawait tobub.adapter.dismissPopups();\nconst location = await tobub.adapter.getCurrentLocation();\nconst user = await tobub.atoms.extractItem({\n  selector: \"#user_detail_element\",\n  fields: [\n    { name: \"avatarUrl\", selector: 'span[data-e2e=\"live-avatar\"] img', source: \"src\" },\n    { name: \"nickname\", selector: 'div[data-e2e=\"user-info\"] h1', source: \"text\" },\n    { name: \"followText\", selector: '[data-e2e=\"user-info-follow\"]', source: \"text\" },\n    { name: \"fansText\", selector: '[data-e2e=\"user-info-fans\"]', source: \"text\" },\n    { name: \"likeText\", selector: '[data-e2e=\"user-info-like\"]', source: \"text\" },\n    { name: \"douyinId\", selector: 'span:has-text(\"抖音号：\")', source: \"text\", match: { pattern: \"抖音号：(.+)\" } },\n    { name: \"ipLocation\", selector: 'span:has-text(\"IP属地：\")', source: \"text\", match: { pattern: \"IP属地：(.+)\" } },\n    { name: \"remark\", selector: 'div[data-e2e=\"user-info\"] > div:last-child', source: \"text\" },\n    { name: \"works\", selector: 'div#user-tabbar span[data-e2e=\"user-tab-count\"]', source: \"textContent\" }\n  ]\n});\nconst userUrl = location.url || \"https://www.douyin.com/user/\" + uid;\nawait tobub.db.saveContent({\n  platform: \"douyin\",\n  contentType: \"user\",\n  externalId: uid,\n  title: user.nickname ?? uid,\n  summary: user.remark ?? \"\",\n  url: userUrl,\n  metadata: { ...user, uid },\n  rawData: user\n});\nreturn { user: { ...user, uid, url: userUrl } };",
    "platform": "douyin",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user"
      ],
      "properties": {
        "user": {
          "type": "object"
        }
      }
    },
    "ui_schema": {
