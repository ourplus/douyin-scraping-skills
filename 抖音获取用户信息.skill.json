      "fields": [
        {
          "key": "uid",
          "label": "用户 ID",
          "type": "text",
          "target": "params.uid",
          "required": true
        }
      ]
    },
    "requirements": {
      "account": "optional",
      "profile": "optional",
      "domain_rule": "required"
    },
    "defaults": {
