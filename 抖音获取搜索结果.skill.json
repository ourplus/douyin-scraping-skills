    "name": "抖音获取搜索结果",
    "source_type": "local",
    "skill_code": "const searchKey = String(tobub.params.searchKey);\nconst minScrollTimes = Number(tobub.params.minScrollTimes);\nconst maxScrollTimes = Number(tobub.params.maxScrollTimes);\nconst records = [];\nawait tobub.adapter.navigate({ url: \"https://www.douyin.com/search/\" + searchKey + \"?type=general\", waitUntil: \"domcontentloaded\" });\nawait tobub.atoms.waitFor({ title: \"抖音搜索\", titleMatch: \"contains\", timeout: 15000 });\nawait tobub.adapter.dismissPopups();\nawait tobub.atoms.waitFor({ delay: tobub.utils.randInt(3000, 6000) });\nawait tobub.atoms.click({ selector: 'div#search-toolbar-container div:text-is(\"多列\")' });\nconst scrollTimes = tobub.utils.randInt(minScrollTimes, maxScrollTimes);\nfor (let i = 0; i < scrollTimes; i++) {\n  await tobub.atoms.waitFor({ delay: tobub.utils.randInt(3000, 8500) });\n  await tobub.atoms.scroll({ mode: \"viewport\", distance: tobub.utils.randInt(390, 1200), steps: tobub.utils.randInt(3, 15), stepPauseRange: [10, 25] });\n  const videoList = await tobub.adapter.extract(\"search_videos\", { scan: { mode: \"append\" } });\n  for (const record of videoList.records) {\n    records.push(record);\n    const fields = record.fields ?? {};\n    const externalId = String(record.id || fields.vid || \"\");\n    if (!externalId) continue;\n    await tobub.db.saveContent({\n      platform: \"douyin\",\n      contentType: \"video\",\n      externalId,\n      title: fields.intro ?? \"抖音视频 \" + externalId,\n      summary: fields.author ?? \"\",\n      url: \"https://www.douyin.com/video/\" + externalId,\n      metadata: {\n        thumb: fields.thumb ?? \"\",\n        duration: fields.duration ?? \"\",\n        like: fields.like ?? \"\",\n        author: fields.author ?? \"\",\n        time: fields.time ?? \"\"\n      },\n      rawData: fields\n    });\n  }\n}\nreturn { query: searchKey, records, scans: scrollTimes };",
    "platform": "douyin",
