    "release_id": "local-tests-20260906",
    "name": "获取抖音视频下载地址",
    "source_type": "local",
    "skill_code": "const awemeId = String(tobub.params.awemeId);\nconst responseWaitMs = Number(tobub.params.responseWaitMs);\nconst watch = await tobub.browser.network.watch({ id: \"douyin-aweme-detail\", urlPattern: \"aweme/v1/web/aweme/detail\", methods: [\"GET\"], captureResponseBody: true, maxRecords: 10 });\nawait tobub.atoms.navigate({ url: \"https://www.douyin.com/video/\" + awemeId, waitUntil: \"domcontentloaded\" });\nawait tobub.atoms.waitFor({ delay: responseWaitMs });\nconst networkRecords = await tobub.browser.network.collect(watch);\nconst captured = networkRecords.find((item) => item.response && typeof item.response.body === \"string\");\nif (!captured || !captured.response || typeof captured.response.body !== \"string\") throw new Error(\"未捕获到抖音 aweme 详情响应\");\nconst payload = JSON.parse(captured.response.body);\nconst rawData = { ...payload };\ndelete rawData.aweme_detail;\nconst awemeDetail = payload.aweme_detail ?? {};\nconst video = awemeDetail.video ?? {};\nconst playAddr = video.play_addr ?? {};\nconst downloadUrls = Array.isArray(playAddr.url_list) ? playAddr.url_list : [];\nconst download1 = typeof downloadUrls[0] === \"string\" ? downloadUrls[0] : \"\";\nconst download2 = typeof downloadUrls[1] === \"string\" ? downloadUrls[1] : \"\";\nconst download3 = typeof downloadUrls[2] === \"string\" ? downloadUrls[2] : \"\";\nconst title = typeof awemeDetail.desc === \"string\" && awemeDetail.desc ? awemeDetail.desc : \"抖音视频 \" + awemeId;\nawait tobub.db.saveContent({\n  platform: \"douyin\",\n  contentType: \"video\",\n  externalId: awemeId,\n  title,\n  url: \"https://www.douyin.com/video/\" + awemeId,\n  metadata: { downloadUrls, download1, download2, download3, responseUrl: captured.request.url },\n  rawData\n});\nreturn { awemeId, downloadUrls, download1, download2, download3, responseUrl: captured.request.url };",
    "platform": "douyin",
