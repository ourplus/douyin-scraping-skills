  "skill": {
    "market_skill_id": "douyin-get-user-videos",
    "release_id": "local-tests-20260906",
    "name": "抖音获取用户作品",
    "source_type": "local",
    "skill_code": "const uid = String(tobub.params.uid);\nconst maxScrollTimes = Number(tobub.params.maxScrollTimes);\nawait tobub.adapter.navigate({ url: \"https://www.douyin.com/user/\" + uid, waitUntil: \"domcontentloaded\" });\nawait tobub.atoms.waitFor({ title: \"的抖音\", titleMatch: \"contains\", timeout: 15000 });\nawait tobub.adapter.dismissPopups();\nconst location = await tobub.adapter.getCurrentLocation();\nconst userDetails = await tobub.atoms.extractItem({\n  selector: \"#user_detail_element\",\n  fields: [\n    { name: \"avatarUrl\", selector: 'span[data-e2e=\"live-avatar\"] img', source: \"src\" },\n    { name: \"nickname\", selector: 'div[data-e2e=\"user-info\"] h1', source: \"text\" },\n    { name: \"followText\", selector: '[data-e2e=\"user-info-follow\"]', source: \"text\" },\n    { name: \"fansText\", selector: '[data-e2e=\"user-info-fans\"]', source: \"text\" },\n    { name: \"likeText\", selector: '[data-e2e=\"user-info-like\"]', source: \"text\" },\n    { name: \"douyinId\", selector: 'span:has-text(\"抖音号：\")', source: \"text\", match: { pattern: \"抖音号：(.+)\" } },\n    { name: \"ipLocation\", selector: 'span:has-text(\"IP属地：\")', source: \"text\", match: { pattern: \"IP属地：(.+)\" } },\n    { name: \"remark\", selector: 'div[data-e2e=\"user-info\"] > div:last-child', source: \"text\" }\n  ]\n});\nconst works = await tobub.atoms.extractItem({ selector: \"div#user-tabbar\", fields: [{ name: \"count\", selector: 'span[data-e2e=\"user-tab-count\"]', source: \"textContent\" }] });\nconst userUrl = location.url || \"https://www.douyin.com/user/\" + uid;\nconst userContent = await tobub.db.saveContent({\n  platform: \"douyin\",\n  contentType: \"user\",\n  externalId: uid,\n  title: userDetails.nickname ?? uid,\n  summary: userDetails.remark ?? \"\",\n  url: userUrl,\n  metadata: { ...userDetails, uid, works: works.count ?? \"\" },\n  rawData: userDetails\n});\nconst records = [];\nfor (let i = 0; i < maxScrollTimes; i++) {\n  await tobub.atoms.waitFor({ delay: 3200 });\n  await tobub.atoms.scroll({ mode: \"viewport\", distance: tobub.utils.randInt(390, 1200), steps: tobub.utils.randInt(3, 15), stepPauseRange: [10, 25] });\n  const postList = await tobub.adapter.extract(\"post_list\", { scan: { mode: \"append\" } });\n  for (const record of postList.records) {\n    records.push(record);\n    const fields = record.fields ?? {};\n    const externalId = String(record.id || \"\");\n    if (!externalId) continue;\n    await tobub.db.saveContent({\n      platform: \"douyin\",\n      contentType: \"video\",\n      externalId,\n      parentId: userContent.contentItemId,\n      title: fields.intro ?? \"抖音视频 \" + externalId,\n      summary: fields.status ?? \"\",\n      url: \"https://www.douyin.com/video/\" + externalId,\n      metadata: {\n        image: fields.image ?? \"\",\n        status: fields.status ?? \"\",\n        comments: fields.comments ?? \"0\"\n      },\n      rawData: fields\n    });\n  }\n  if (postList.scannedCount === 0) {\n    const endState = await tobub.atoms.condition({ type: \"text\", selector: \"body\", text: \"暂时没有更多了\", timeout: 250, throwOnTimeout: false });\n    if (endState.satisfied) break;\n  }\n}\nreturn { user: { ...userDetails, uid, works: works.count, url: userUrl }, records };",
    "platform": "douyin",
